focus", "survey_link": null}, "related_items": [{"access_restricted": false, "aka": ["http://www.loc.gov/collections/stereograph-cards/articles-and-essays/mystery-stereographs/"], "campaigns": [], "date": "1860", "dates": ["[1860 TO 1945]"], "description": ["Please Help Us Solve a Mystery! Some stereographs have either no associated caption information or very little information. Please help us identify the images displayed below. These selections will change every few months."], "digitized": true, "extract_timestamp": "2026-10-29T06:19:37.015Z", "group": ["cms", "managed-content"], "hassegments": false, "id": "http://www.loc.gov/collections/stereograph-cards/articles-and-essays/mystery-stereographs/", "image_url": ["https://www.loc.gov/static/collections/stereograph-cards/images/1s01697r.jpg"], "index": 1, "language": ["english"], "location": ["mexico", "panama", "united states", "italy"], "mime_type": ["image/jpg"], "online_format": ["image"], "original_format": ["web page"], "partof": ["stereograph cards"], "score": 14.910516, "shelf_id": "~/collections/stereograph-cards/articles-and-essays/mystery-stereographs/", "site": ["cms"], "subject": ["landscapes", "photographs", "stereographs", "expositions", "warfare", "national parks"], "timestamp": "2026-10-29T07:39:10.395Z", "title": "Mystery Stereographs | Articles and Essays | Stereograph Cards | Digital Collections", "type": ["web page"], "url": "https://www.loc.gov/collections/stereograph-cards/articles-and-essays/mystery-stereographs/"}, {"access_restricted": false, "aka": ["http://www.loc.gov/collections/stereograph-cards/articles-and-essays/viewing-stereographs-in-3d/"], "campaigns": [], "date": "1860", "dates": ["[1860 TO 1945]"], "description": ["The start of the American Civil War in 1861 coincided with a surge in stereo photography--a technique that renders photos in three-dimensional depth. A pair of similar images combines into a single 3-D scene using a special viewer. (Or, you can \"freeview\" by crossing your eyes!)"], "digitized": true, "extract_timestamp": "2026-10-29T06:19:37.015Z", "group": ["cms", "managed-content"], "hassegments": false, "id": "http://www.loc.gov/collections/stereograph-cards/articles-and-essays/viewing-stereographs-in-3d/", "image_url": ["https://www.loc.gov/static/collections/stereograph-cards/500_500.jpg"], "index": 2, "language": ["english"], "location": ["mexico", "panama", "united states", "italy"], "mime_type": ["image/jpg"], "online_format": ["image"], "original_format": ["web page"], "partof": ["stereograph cards"], "score": 14.910516, "shelf_id": "~/collections/stereograph-cards/articles-and-essays/viewing-stereographs-in-3d/", "site": ["cms"], "subject": ["landscapes", "photographs", "stereographs", "expositions", "warfare", "national parks"], "timestamp": "2026-10-29T07:39:10.395Z", "title": "Viewing Stereographs in 3D | Articles and Essays | Stereograph Cards | Digital Collections", "type": ["web page"], "url": "https://www.loc.gov/collections/stereograph-cards/articles-and-essays/viewing-stereographs-in-3d/"}, {"access_restricted": false, "aka": ["http://www.loc.gov/collections/lawrence-and-houseworth/articles-and-essays/photographers/"], "campaigns": [], "date": "1862", "dates": ["[1862 TO 1867]"], "description": ["Photographers Who Worked for Lawrence &amp; Houseworth and their Holdings in the Prints &amp; Photographs Division In the nineteenth century publishers often purchased negatives from photographers and printed the photographs without providing credit to the original photographer. This practice makes it difficult to determine the original photographer of commercial views. The following photographers were associated with Lawrence &amp; Houseworth."], "digitized": true, "extract_timestamp": "2026-10-29T06:03:35.028Z", "group": ["cms", "managed-content"], "hassegments": false, "id": "http://www.loc.gov/collections/lawrence-and-houseworth/articles-and-essays/photographers/", "image_url": ["https://www.loc.gov/static/collections/lawrence-and-houseworth/500_500.jpg"], "index": 3, "language": ["english"], "location": ["united states"], "mime_type": ["image/jpg"], "online_format": ["image"], "original_format": ["web page"], "partof": ["lawrence & houseworth collection"], "score": 13.396799, "shelf_id": "~/collections/lawrence-and-houseworth/articles-and-essays/photographers/", "site": ["cms"], "subject": ["albumen prints", "photographic prints", "stereographs"], "timestamp": "2026-10-29T07:36:26.038Z", "title": "Photographers | Articles and Essays | Lawrence & Houseworth Collection | Digital Collections", "type": ["web page"], "url": "https://www.loc.gov/collections/lawrence-and-houseworth/articles-and-essays/photographers/"}, {"access_restricted": false, "aka": ["http://www.loc.gov/collections/lawrence-and-houseworth/articles-and-essays/stereographs/"], "campaigns": [], "date": "1862", "dates": ["[1862 TO 1867]"], "description": ["A full team on the Sierras LC-USZ62-27399 Stereographs are two photographs mounted side-by-side that appear three-dimensional when placed in a viewer called a stereoscope. In the mid to late nineteenth century, collecting stereographs was a popular middle class pastime. People acquired stereographs of tourist spots they had visited, as well as exotic locales that they would only experience through the wonder of the stereoscope. Viewing stereographs was a common activity, much like watching television or going to the movies today."], "digitized": true, "extract_timestamp": "2026-10-29T06:03:35.028Z", "group": ["cms", "managed-content"], "hassegments": false, "id": "http://www.loc.gov/collections/lawrence-and-houseworth/articles-and-essays/stereographs/", "image_url": ["https://www.loc.gov/static/collections/lawrence-and-houseworth/images/stereographs.jpg"], "index": 4, "language": ["english"], "location": ["united states"], "mime_type": ["image/jpg"], "online_format": ["image"], "original_format": ["web page"], "partof": ["lawrence & houseworth collection"],