12, "tz_aware": null, "unionFacets": "", "webcast_permalink": null}, "related": {"group_record": null, "lot_link": null, "neighbors": "https://www.loc.gov/pictures/related/?&co=cph&pk=2019630603&st=gallery&sb=call_number#focus", "survey_link": null}, "related_items": [{"access_restricted": false, "aka": ["http://www.loc.gov/resource/wdl.14787/", "http://www.loc.gov/resource/gdcwdl.wdl_14787/", "http://www.loc.gov/item/2021666987/", "http://lccn.loc.gov/2021666987", "https://hdl.loc.gov/loc.wdl/wdl.14787"], "campaigns": [], "contributor": ["gace, de la buigne, 1380", "gaston iii, ph\u0153bus, count of foix", "v\u00e9rard, antoine, died approximately 1513"], "date": "1507-01-01", "dates": ["1507"], "description": ["Gaston III (1331-91), count of Foix and viscount of Be\u0301arn, also known as Gaston Phoebus because of his shiny blond hair, wrote his book on hunting between 1387 and 1389 and dedicated it to Philip the Bold, Duke of Burgundy, also an avid hunter. Written in French, the treatise is in five parts, which successively describe the habits of several types of game animals; the maintenance of hunting dogs; deer hunting; hunting other types of game; and finally the less-noble methods of hunting involving traps. The first printed edition of the work, abundantly illustrated with wood-block prints, was published by bookseller Antoine Ve\u0301rard in Paris in around 1507. Ve\u0301rard added to Gaston's text a debate in verse on the merits of using birds of prey for hunting (hawking and falconry) and those of hunting with hounds. The added section was an extract from another 14th century treatise on hunting, also dedicated to Philip the Bold, called Roman des de\u0301duis (The pleasures of hunting), by Gace de la Buigne (died circa 1380)."], "digitized": true, "extract_timestamp": "2021-07-23T23:36:06.271Z", "group": ["wdlpartner", "catalog-split-15", "catalog", "world-digital-library-partners", "main-catalog-split-15", "main-catalog"], "hassegments": true, "id": "h